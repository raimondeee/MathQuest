{
  "name": "mathquest",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/copy-content.js",
    "dev": "vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview --host",
    "check": "node scripts/check-content.js",
    "build:local": "tsc && vite build --mode singlefile && cp dist-local/index.html ../MathQuest.html && echo 'Wrote ../MathQuest.html'",
    "wire-v2": "node scripts/wire-v2.js"
  },
  "devDependencies": {
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
